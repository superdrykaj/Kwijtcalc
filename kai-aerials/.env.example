# ============================================================================
#  Omgevingsvariabelen — kopieer dit bestand naar .env.local en vul het in.
#  Deze waarden staan ALLEEN op de server en komen nooit in de frontend.
#  Zet .env.local nooit in je repository.
# ============================================================================

# --- Beheeromgeving (verplicht) ---------------------------------------------
# Maak beide waarden met:  npm run hash-password -- 'jouw-lange-wachtwoord'
ADMIN_PASSWORD_HASH=""
AUTH_SECRET=""

# --- Website ----------------------------------------------------------------
# Publieke adres van de site. Gebruikt voor metadata, sitemap en deelbeelden.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Opslag (optioneel) ------------------------------------------------------
# Standaard staan de database en de uploads in de map ./data
# DATA_DIR="/var/lib/kai-aerials"
# DATABASE_PATH="/var/lib/kai-aerials/kai-aerials.db"

# --- E-mail (optioneel, maar nodig voor bevestigingsmails) -------------------
# Zolang deze waarden leeg zijn, wordt er GEEN e-mail verstuurd. Aanvragen en
# berichten worden wel gewoon opgeslagen en de site zegt er eerlijk bij dat er
# geen mail is verzonden.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Kai Aerials <no-reply@voorbeeld.nl>"
MAIL_TO="hallo@kaiaerials.example"
